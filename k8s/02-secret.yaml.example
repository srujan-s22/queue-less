# ==============================================================================
# EXAMPLE SECRET TEMPLATE FOR LOCAL MINIKUBE DEMONSTRATION
# DO NOT COMMIT REAL CREDENTIALS. THIS FILE CONTAINS PLACEHOLDERS ONLY.
#
# Preferred CLI creation (no files created on disk):
#   kubectl create secret generic queueless-secret \
#     --namespace=queueless \
#     --from-literal=JWT_SECRET=$(openssl rand -hex 32) \
#     --from-literal=STAFF_ACCESS_KEY=$(openssl rand -hex 16) \
#     --from-literal=ADMIN_ACCESS_KEY=$(openssl rand -hex 16)
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: queueless-secret
  namespace: queueless
  labels:
    app.kubernetes.io/name: queueless
    app.kubernetes.io/part-of: queueless-platform
type: Opaque
stringData:
  # Must be a cryptographically secure string of at least 32 characters in production.
  JWT_SECRET: "PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_HEX_32_MINIMUM_32_CHARS"
  # Registration access key for staff accounts (minimum 8 characters in production).
  STAFF_ACCESS_KEY: "PLACEHOLDER_STAFF_ACCESS_KEY_MINIMUM_8_CHARS"
  # Registration access key for administrator accounts (minimum 8 characters in production).
  ADMIN_ACCESS_KEY: "PLACEHOLDER_ADMIN_ACCESS_KEY_MINIMUM_8_CHARS"

