# QueueLess Environment Variables Template
# Copy this file to .env before starting Docker Compose: cp .env.example .env

# Security — JWT Secret (REQUIRED for Docker Compose, at least 32 characters)
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=queueless_super_secret_jwt_key_2026_production_safe_string_min_32_chars

# Ports & Application URLs
PORT=5001
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

# MongoDB Database URI (for Docker Compose: mongodb://mongo:27017/queueless)
MONGODB_URI=mongodb://mongo:27017/queueless
